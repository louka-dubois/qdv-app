@page
@model QDVapp.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Mot de passe oublié?";
}

<h2>Mot de passe oublié?</h2>
<hr />

<p>Entrez votre courriel pour recevoir un lien de réinitialisation.</p>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nom@exemple.com" />
                <label asp-for="Input.Email">Courriel</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Envoyer le lien de réinitialisation</button>
        </form>
    </div>
</div>

