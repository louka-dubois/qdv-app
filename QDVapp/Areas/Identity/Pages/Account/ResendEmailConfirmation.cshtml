@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Renvoyer le courriel de vérification";
}

<h1 class="h3">Renvoyer le courriel de vérification</h1>
<h2 class="h5 text-muted">Entrez votre courriel.</h2>
<hr />

@if (Model.ShowStatus)
{
    <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
}

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" aria-required="true" placeholder="nom@exemple.com" />
                <label asp-for="Input.Email">Courriel</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Renvoyer le courriel</button>
        </form>
        <p class="mt-3"><a asp-area="Identity" asp-page="/Account/Login">Retour à la connexion</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}